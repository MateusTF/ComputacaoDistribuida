{
  "name": "streaming-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serviço de streaming de músicas em Node.js/TypeScript: REST, GraphQL, gRPC e SOAP",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "rest": "node src/rest.ts",
    "graphql": "node src/graphql.ts",
    "grpc": "node src/grpc.ts",
    "soap": "node src/soap.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "express": "^5.3.0",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.1",
    "pg": "^8.23.1",
    "soap": "^1.14.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
